# Power Automate HTTP トリガ用の環境変数 (mail エージェントから呼ばれる)
# 実値は `.env.powerautomate` (gitignore) に保存する。本ファイルはサンプルのみ。

# get-unread-mails フローの完全 URL (sig パラメータ込み)
PA_UNREAD_MAILS_URL="https://prod-XX.japaneast.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?api-version=2016-06-01&sv=1.0&sig=..."

# teams-notify フローの完全 URL
PA_TEAMS_NOTIFY_URL="https://prod-XX.japaneast.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?api-version=2016-06-01&sv=1.0&sig=..."

# Claude 側からフローへ渡す共有シークレット (32 byte ランダム文字列推奨)
# 生成例: openssl rand -base64 32
PA_SHARED_SECRET="<replace-me>"

# Teams 通知の既定送信先 (チャットの場合)
# Power Automate 側で固定する場合は不要。Claude 側で切り替えたいときに使う。
PA_DEFAULT_CHAT_ID=""
PA_DEFAULT_TEAM_ID=""
PA_DEFAULT_CHANNEL_ID=""
